# Gremlin server endpoint
GREMLIN_URL=ws://localhost:8182/gremlin

# Traversal source (commonly "g")
GREMLIN_TRAVERSAL_SOURCE=g

# Gremlin username
GREMLIN_USERNAME=your_username

# Gremlin password
GREMLIN_PASSWORD=your_password

# MCP transport: "stdio" or "streamable-http"
MCP_TRANSPORT=stdio

# ownCloud file storage (used to store generated diagrams and return a download link)
OWNCLOUD_URL=https://your-owncloud-instance.com/
OWNCLOUD_USERNAME=your_owncloud_username
# Not used by the client — authentication goes through OWNCLOUD_TOKEN below.
OWNCLOUD_PASSWORD=
# App token sent as the *password* of an HTTP Basic auth header
# (username:token). On ownCloud Infinite Scale (oCIS), create one with the
# auth-app service: `ocis auth-app create --user-name=<user> --expiration=720h`.
# See the README section "Getting an ownCloud API token".
OWNCLOUD_TOKEN=
# Remote folder (collection) diagrams are uploaded into
OWNCLOUD_REMOTE_DIR=theo-diagrams
# Verify the TLS certificate. The default endpoint is an IP with a self-signed
# cert, so this is off by default; set to true if your instance has a valid cert.
OWNCLOUD_VERIFY_SSL=false

# Graph backup (create_graph_backup). Absolute path to an existing directory,
# typically a separate git repository — each run overwrites the same files, so
# the git history becomes the history of the graph. The tool never creates the
# directory itself.
BACKUP_DIR=C:\Users\your_user\private_repos\theo-graph-backup
# Vertex labels to leave out, comma-separated. Empty means the default,
# "verse, receptionPassage" — both are re-imported from their own source rather
# than restored from the backup, and both are too numerous to diff usefully.
BACKUP_EXCLUDED_VERTEX_LABELS=
# Edge labels to leave out, comma-separated. Empty means the default, "next" —
# the verse chain, which the verse import rebuilds. Every other edge is backed
# up, including the ones between two verses (verse -isParallelTo-> verse).
BACKUP_EXCLUDED_EDGE_LABELS=
